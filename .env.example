# ==============================================================================
# AGENTPULSE FRAMEWORK - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Instructions:
#   1. Copy this file to '.env' in the project root directory.
#   2. Fill in the authorized security and provider keys.
#   3. The framework requires a valid .env file to run.
#   4. Do NOT commit the '.env' file to Git or public repositories.
# ==============================================================================

# 1. Framework Security & Authorization Key (Required to unlock framework execution)
AGENTPULSE_AUTH_KEY=your_authorized_agentpulse_auth_key_here
AGENTPULSE_ENV=production

# 2. Telemetry Ingestion API Key (Required for SDK ingestion and server endpoints)
AGENTPULSE_API_KEY=ap_live_your_telemetry_key_here
AGENTPULSE_BACKEND_URL=http://localhost:8000

# 3. Model Provider Credentials (Required for Live Agent & LLM Judge)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# 4. Model Selection & Engine Settings
AGENT_MODEL=claude-3-5-haiku-20241022
JUDGE_MODEL=claude-3-5-haiku-20241022
USE_MOCK_LLM=true

# 5. Database Persistence URL (Default: SQLite local database)
DATABASE_URL=sqlite:///./eval_framework.db

# 6. Observability & Security Guardrails
AGENTPULSE_MAX_PAYLOAD_BYTES=5242880
AGENTPULSE_REDACT_SECRETS=true
AGENTPULSE_REQUEST_TIMEOUT_MS=5000
