# Copy this file to .env and fill in your real key before running in live mode.

# Your Anthropic API key (get one at https://console.anthropic.com/)
ANTHROPIC_API_KEY=your-api-key-here

# Model used by both the demo agent and the LLM-judge evaluator.
# Use a cheap/fast model to keep eval-suite costs low.
AGENT_MODEL=claude-3-5-haiku-20241022
JUDGE_MODEL=claude-3-5-haiku-20241022

# Set to "true" to run the whole pipeline with a canned, deterministic
# fake LLM (no API key, no cost, no network) -- useful for testing the
# tracing/storage/dashboard plumbing before wiring up a real key.
USE_MOCK_LLM=true

# Database. Defaults to a local SQLite file. Swap this for a Postgres
# URL (e.g. postgresql://user:pass@host:5432/dbname) to run against a
# real DB server without changing any application code.
DATABASE_URL=sqlite:///./eval_framework.db

# AgentPulse SDK Configuration.
# API Key for authenticating SDK telemetry ingestion requests.
# If not set, the ingestion server runs in open-access mode (local dev).
AGENTPULSE_API_KEY=

# Backend URL for the SDK to send telemetry to.
# Default: http://localhost:8000
# Set to "local" for direct in-process DB writes (no server needed).
AGENTPULSE_BACKEND_URL=http://localhost:8000
